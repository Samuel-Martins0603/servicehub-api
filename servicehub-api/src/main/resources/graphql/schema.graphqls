# Endpoint alternativo GraphQL (POST /graphql). Somente leitura do catalogo publico.
# A lista de ServiceCategory precisa ser identica a do enum Java e a do CHECK da migracao V3.

type Query {
    "Lista servicos ativos (mesmas regras do GET /api/v1/services). size maximo: 100."
    services(page: Int = 0, size: Int = 20, category: ServiceCategory, providerId: ID,
             minPrice: Float, maxPrice: Float, q: String): ServicePage!
    "Busca um servico pelo id. Inativo (para o publico) ou inexistente retorna null."
    service(id: ID!): Service
}

type ServicePage {
    content: [Service!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type Service {
    id: ID!
    title: String!
    description: String
    price: Float!
    category: ServiceCategory!
    active: Boolean!
    providerId: ID!
    providerName: String!
    createdAt: String
    updatedAt: String
}

enum ServiceCategory {
    ELETRICA
    HIDRAULICA
    LIMPEZA
    PINTURA
    JARDINAGEM
    MARCENARIA
    ALVENARIA
    SUPORTE_TI
    AULAS_PARTICULARES
    BELEZA
    SAUDE_BEM_ESTAR
    TRANSPORTE
    MUDANCA
    CLIMATIZACAO
    CHAVEIRO
    DEDETIZACAO
    CUIDADOR
    PET
    EVENTOS
    FOTOGRAFIA
    OUTROS
}
