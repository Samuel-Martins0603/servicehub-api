# Endpoint alternativo GraphQL (POST /graphql). Somente leitura do catalogo publico.
# A lista de ServiceCategory vem do servicehub_schema.sql e precisa ser identica a do enum Java e a do CHECK da V3.

type Query {
    "Lista servicos ativos (mesmas regras do GET /ServiceHub/v1/services). size maximo: 100."
    services(page: Int = 0, size: Int = 20, category: ServiceCategory, providerId: ID,
             minPrice: Float, maxPrice: Float, q: String): ServicePage!
    "Busca um servico pelo id. Inativo (para o publico) ou inexistente retorna null."
    service(id: ID!): Service
}

type ServicePage {
    content: [Service!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type Service {
    id: ID!
    title: String!
    description: String
    price: Float!
    category: ServiceCategory!
    active: Boolean!
    providerId: ID!
    providerName: String!
    createdAt: String
    updatedAt: String
}

enum ServiceCategory {
    LIMPEZA
    DIARISTA
    ENCANAMENTO
    ELETRICA
    JARDINAGEM
    PINTURA
    MARCENARIA
    PEDREIRO
    DEDETIZACAO
    AR_CONDICIONADO
    CHAVEIRO
    MONTAGEM_MOVEIS
    MUDANCA
    SUPORTE_TECNICO
    MANUTENCAO_COMPUTADORES
    DESENVOLVIMENTO_SOFTWARE
    REDES_E_INFRAESTRUTURA
    SEGURANCA_DIGITAL
    RECUPERACAO_DE_DADOS
    CONSULTORIA_TI
    OUTROS
}
