# Copie para .env e ajuste. O arquivo .env NAO vai para o Git.

# Segredo do JWT: minimo 32 bytes. Sem ele a API nao sobe. TROQUE este valor de exemplo.
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-mais-de-32-bytes

# Primeiro ADMIN, criado no startup (senha: 8-72 caracteres, 1 maiuscula e 1 numero)
ADMIN_EMAIL=admin@servicehub.local
ADMIN_PASSWORD=TroqueEstaSenha1
ADMIN_NAME=Administrador

# Origens liberadas no CORS (separadas por virgula). Bancada de testes: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL do Docker Compose
POSTGRES_DB=servicehub
POSTGRES_USER=servicehub
POSTGRES_PASSWORD=troque-esta-senha-do-banco
